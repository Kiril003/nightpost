//
// google-services.json lives at phantom-companion/app/google-services.json, is git-ignored and is never
// committed. Without it the plugin, the dependencies and this class are all absent and the app does nothing.
//
// Server contract (not built yet): a data-only message {"w":"1"}, android.priority=high, collapse_key="wake",
// no "notification" block. FCM token registration with the relay is a server item; onNewToken stays empty
// until that endpoint exists.
package local.phantom.companion.service

import com.google.firebase.messaging.FirebaseMessagingService
import com.google.firebase.messaging.RemoteMessage

class PushWakeService : FirebaseMessagingService() {

    override fun onMessageReceived(message: RemoteMessage) {
        PushWake.shared(applicationContext).onData(message.data)
    }
}
