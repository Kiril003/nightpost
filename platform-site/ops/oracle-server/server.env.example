# Every variable the server reads. Copy to /srv/nightpost-api/server.env (chmod 600). Names only.
# Paths (LICENSE_DB, LICENSE_SIGNING_KEY, LICENSE_POLICY, RELAY_DB, TRUTH_DB) are fixed by the Dockerfile; do not set them.
# SITE_ORIGINS and TRUSTED_COUNTRY_HEADER are fixed in compose.yaml.

# --- Core ---
ADMIN_TOKEN=
DATABASE_URL=            # Supabase Transaction pooler: aws-*.pooler.supabase.com:6543, user postgres.<ref>. The direct db.<ref>.supabase.co:5432 host is IPv6-only and the VM has no IPv6
DB_POOL_MAX=
DB_POOL_MAX_IDLE=
DOWNLOAD_POLICY=
BETA_CLAIM_OPEN=
DIRECTORY_OPEN=
OWNER_EMAIL=
OWNER_PUBKEY=
TRUSTED_PROXY_CIDRS=
POINTS_DB=
VENUE_DB=
SUPPORT_DB=
VENUE_MEDIA_DIR=
VENUE_MEDIA_KEY_SECRET=
DESKTOP_RELEASE=

# --- Licences and billing ---
LS_WEBHOOK_SECRET=
LS_DEFAULT_TIER=
LS_VARIANT_TIERS=
TIER_ACTIVATIONS=
PLAY_PACKAGE_NAME=
PLAY_SERVICE_ACCOUNT_FILE=
PLAY_SERVICE_ACCOUNT_JSON=
PLAY_PRODUCT_TIERS=
PLAY_RTDN_TOKEN=
PLAY_INTEGRITY_DECRYPTION_KEY=
PLAY_INTEGRITY_VERIFICATION_KEY=
BRAIN_PLAY_PACKAGE=
BRAIN_PLAY_CERT_SHA256=

# --- Mail ---
SMTP_HOST=
SMTP_PORT=               # 587 or 465; Oracle blocks outbound 25
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TIMEOUT=
SMTP_MAX_CONCURRENT=
SMTP_BREAKER_FAILURES=
SMTP_BREAKER_COOLDOWN=
MAIL_DEV_SINK=           # leave empty in production

# --- Builds (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_BUILDS=

# --- Brain (/api/brain) ---
GEMINI_API_KEY=
VERTEX_PROJECT=
VERTEX_LOCATION=         # global
GOOGLE_APPLICATION_CREDENTIALS=   # /secrets/vertex-sa.json (file in /srv/nightpost-api/secrets)
GOOGLE_SA_JSON=          # alternative to the file; avoid, multi-line
BRAIN_THINKING_DEFAULT=LOW # thinking sent when the phone sends none (3.8/3.7 flash); empty = send none
BRAIN_PROFILES=            # JSON object profile -> model (chat, act, voice, summary); empty = built-in map
BRAIN_DAILY_PER_DEVICE=
BRAIN_FOLLOW_UPS_PER_ASK=   # follow-up asks per ask in the daily count; empty = 3
BRAIN_PER_IP_MINUTE=
BRAIN_PER_IP_DAY=
BRAIN_DAILY_GLOBAL=
BRAIN_DAY_KEY_ONLY=
BRAIN_DAY_FREE=
BRAIN_DAY_PERSONAL=
BRAIN_DAY_CREW=
BRAIN_DAY_LEGACY_TOTAL=
BRAIN_ATTEST_PER_IP_DAY=
BRAIN_KEY_ONLY_IP_FACTOR=
BRAIN_LIVE_PER_DAY=        # Live tokens per device per day; empty = 20
BRAIN_LIVE_TOTAL_DAY=      # Live tokens for all devices per day; empty = 400
BRAIN_LIVE_MODEL=          # model name returned with the token; empty = built-in

# --- Calls (TURN stays on this VM: coturn) ---
TURN_URLS=
TURN_SECRET=
STUN_URLS=
TURN_TTL=

# --- Solana ---
SOLANA_RPC_URL=
SOLANA_RPC_URL_DEVNET=
SOLANA_RPC_URL_MAINNET=
SOLANA_RPC_PER_IP_MINUTE=
SOLANA_RPC_GLOBAL_MINUTE=
SOLANA_RPC_GLOBAL_DAILY=
SOLANA_RPC_AIRDROP_PER_IP_DAILY=
SOLANA_RPC_AIRDROP_DAILY=
SOLANA_CLAIM_SECRET=
SOLANA_PAY_CLUSTER=
SOLANA_PAY_PRICES=
SOLANA_PAY_RECIPIENT=
SOLANA_SPONSOR_CLUSTER=
SOLANA_SPONSOR_KEY=
SOLANA_SPONSOR_RPC_URL=
SOLANA_SPONSOR_DAILY_QUOTA=
SOLANA_SPONSOR_GLOBAL_DAILY=
SOLANA_SPONSOR_MAX_MICROLAMPORTS=
SOLANA_SPONSOR_MAX_CU=
SOLANA_SPONSOR_MAX_IX=
SOLANA_FAUCET_KEY=       # DEVNET key only, solana-keygen JSON array; ops/faucet.md
SOLANA_FAUCET_RPC_URL=  # set it to a devnet node; unset it falls back to SOLANA_RPC_URL, which may be mainnet
SOLANA_FAUCET_GLOBAL_DAILY=
SOLANA_CLUSTER=           # devnet unless NIGHTPOST_MAINNET_OWNER_YES=1 too
NIGHTPOST_MAINNET_OWNER_YES=
NIGHTPOST_BILL_PROGRAM_ID_DEVNET=
NIGHTPOST_BILL_PROGRAM_ID_MAINNET=
HELIUS_API_KEY=
HELIUS_WEBHOOK_AUTH=
HELIUS_WEBHOOK_ID_DEVNET=
HELIUS_WEBHOOK_ID_MAINNET=
ERASE_RETENTION=
SEEKER_CLAIM_SECRET=
SEEKER_RPC_URL=
SEEKER_SIWS_DOMAIN=
SEEKER_BADGE_DAYS=
SEEKER_PRO_DAYS=

# --- Relay store (optional limits) ---
RELAY_TTL_DAYS=
RELAY_MAX_BYTES=
RELAY_FETCH_BYTES=
RELAY_TAG_BYTES=
RELAY_SWEEP_SECONDS=

# --- Alerts ---
ALARMS_UA_KEY=
ALERTS_SIGNING_KEY=
ALERTS_KEY_ID=

# --- Staff system view (Fly sets these itself; leave empty elsewhere) ---
FLY_IMAGE_REF=
FLY_REGION=
RELAY_LEGACY=               # 0 stops vc30+ phones using the second relay; empty = on
