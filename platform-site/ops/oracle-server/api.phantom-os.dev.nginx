# Site for the host nginx on the VM: /etc/nginx/sites-available/api.phantom-os.dev
# Install on port 80 only, then `sudo certbot --nginx -d api.phantom-os.dev` adds 443 and the redirect.
#
# Privacy: no access log (an IP+path+time line for /relay/* and /truth/* is exactly what the server
# refuses to keep), and the error log is crit-only because error lines carry client and request.
#
# Client IP: the app trusts Fly-Client-IP from a private-range peer. nginx must therefore OVERWRITE it,
# or any caller could pick their own rate-limit key. The only exception is the Fly forwarder
# (MIGRATE.md, step 7) that proves itself with X-Edge-Auth; its secret lives in snippets/np-edge.map.

map $http_x_edge_auth $np_client_ip {
    default $remote_addr;
    include /etc/nginx/snippets/np-edge.map;   # one line: "<secret>" $http_fly_client_ip;
}
map $http_upgrade $np_api_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name api.phantom-os.dev;

    access_log off;
    error_log /var/log/nginx/api.phantom-os.dev.error.log crit;

    client_max_body_size 1m;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    location /.well-known/acme-challenge/ { root /var/www/html; }

    location / {
        proxy_pass http://127.0.0.1:8480;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $np_api_upgrade;
        proxy_set_header Fly-Client-IP $np_client_ip;
        proxy_set_header Fly-Client-Country "";
        proxy_set_header X-Forwarded-For $np_client_ip;
        proxy_set_header X-Edge-Auth "";
        # /api/brain streams server-sent events; buffering would hold them back.
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
