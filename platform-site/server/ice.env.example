# ICE-облікові дані для дзвінків (ice.py): GET /api/ice. Значення — лише у
# `fly secrets set`, ніколи в git: TURN_SECRET — static-auth-secret coturn.
# Без TURN_URLS/TURN_SECRET маршрут чесно віддає {iceServers:[STUN], turn:false}.
TURN_URLS=
TURN_SECRET=
# STUN — необов'язково; порожньо = публічний stun.l.google.com:19302.
STUN_URLS=
# Час життя пари, секунди (типово 3600, не менше 60).
TURN_TTL=
