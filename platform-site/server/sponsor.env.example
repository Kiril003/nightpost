# Спонсор комісій Solana (sponsor.py). Значення — лише у `fly secrets set`, ніколи в git.
# Без SOLANA_SPONSOR_KEY або з кластером, якого немає в APPROVED_CLUSTERS, /api/solana/sponsor віддає 503,
# і телефон чесно платить комісію сам.
SOLANA_SPONSOR_CLUSTER=
# Секрет devnet-ключа: JSON-масив 64 байтів (як solana-keygen) або base58 тих самих 64 байтів.
SOLANA_SPONSOR_KEY=
# Необов'язкові: власний RPC (інакше SOLANA_RPC_URL, інакше публічний вузол кластера) і межі.
SOLANA_SPONSOR_RPC_URL=
SOLANA_SPONSOR_DAILY_QUOTA=
SOLANA_SPONSOR_GLOBAL_DAILY=
SOLANA_SPONSOR_MAX_MICROLAMPORTS=
SOLANA_SPONSOR_MAX_CU=
SOLANA_SPONSOR_MAX_IX=
