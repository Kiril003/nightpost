# Сервер ліцензій. Тонкий образ: FastAPI + uvicorn, більше нічого.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# Шар залежностей окремо від коду: правка одного рядка в main.py не тягне
# за собою перевстановлення всього.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Ключ підпису, база і ПОЛІТИКА живуть на ТОМІ, не в образі. Інакше кожне
# викладення народжувало б новий ключ Ed25519 — і всі раніше видані
# сертифікати миттю ставали б підробками в очах застосунків; а політика (яка
# гасить відбитки й відсікає старі збірки) тихо відкочувалась би до підписаного
# усе-дозволяючого стандарту при кожному деплої.
ENV LICENSE_SIGNING_KEY=/data/keys/signing.pem \
    LICENSE_DB=/data/licenses.db \
    LICENSE_POLICY=/data/keys/policy.json

# Сховок листів — на ВЛАСНОМУ томі, не на томі ліцензій і не в шарі образу.
#
# Був у /tmp, і це називалось платою за приватність: том знімається у знімки
# Fly, а знімок конверта пережив би обіцянку «сім днів і зникає» на тижні.
# Насправді ціна була інша: кожен `fly deploy` витирав усі ще не забрані
# конверти, а телефон-відправник не торкається листа до heldUntilMs — до СЕМИ
# ДІБ тиші на лист, який людина бачить як «У СХОВКУ».
#
# Обидві обіцянки тримаються одночасно лише окремим томом із вимкненими
# знімками: `scheduled_snapshots = false` у fly.toml. Шлях у /data сервер
# відкине на старті — там знімки ввімкнені, і мусять бути.
ENV RELAY_DB=/relay/phantom-relay.db

# Правда від людей — на тому ж томі без знімків і з тієї ж причини: звʼязка
# «ключ ↔ свідчення» обіцяно тримати лише 2 півжиття, а знімок її пережив би.
ENV TRUTH_DB=/relay/phantom-truth.db

EXPOSE 8080

# БЕЗ --proxy-headers: ProxyHeaders бере ЛІВИЙ запис X-Forwarded-For, а Fly
# дописує справжнього клієнта у ХВІСТ — тобто лівий підкидає сам клієнт. Замість
# цього main._client_ip читає Fly-Client-IP лише від довіреного сусіда-проксі
# (приватні діапазони / 6PN), тож ліміти — поклієнтні, а заголовок від чужинця
# нічого не отруює. Діапазон за потреби звужується через TRUSTED_PROXY_CIDRS.
#
# --ws-max-size: найбільший законний кадр живого каналу — вкидання найбільшої
# корзини в base64 (~93 КБ). Типові 16 МБ на кадр × тисяча з'єднань — це
# пам'ять, якої машина на 512 МБ не має.
CMD ["sh", "-c", "mkdir -p /data/keys /relay && exec uvicorn main:app --host 0.0.0.0 --port 8080 --ws-max-size 131072 --ws-ping-interval 20 --ws-ping-timeout 20"]
