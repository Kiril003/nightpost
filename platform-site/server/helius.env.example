# Ключ API Helius для читання й оновлення списку адрес вебхука.
HELIUS_API_KEY=
# Секрет заголовка Authorization, який Helius надсилає у POST /api/solana/hook.
HELIUS_WEBHOOK_AUTH=
# Ідентифікатор вебхука Helius для devnet.
HELIUS_WEBHOOK_ID_DEVNET=
# Ідентифікатор вебхука Helius для mainnet.
HELIUS_WEBHOOK_ID_MAINNET=
