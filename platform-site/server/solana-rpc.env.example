# Проксі Solana JSON-RPC (solana_rpc.py): POST /api/solana/rpc/{devnet|mainnet}.
# Значення — лише у `fly secrets set`, ніколи в git: у цих адресах ключ платного вузла.
# Без адреси кластер віддає 503, і телефон іде на публічний вузол сам.
SOLANA_RPC_URL_DEVNET=
# Mainnet — лише читання; sendTransaction зачинено в коді (MAINNET_SEND_APPROVED).
SOLANA_RPC_URL_MAINNET=
# Необов'язкові межі (типові: 120 на IP/хв, 600/хв і 30000/добу загалом; airdrop 3 на IP і 50 загалом на добу).
SOLANA_RPC_PER_IP_MINUTE=
SOLANA_RPC_GLOBAL_MINUTE=
SOLANA_RPC_GLOBAL_DAILY=
SOLANA_RPC_AIRDROP_PER_IP_DAILY=
SOLANA_RPC_AIRDROP_DAILY=
