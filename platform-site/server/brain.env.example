# Розум сервера Nightpost (/api/brain) для телефонів без власного ключа Gemini.
# Усі змінні необов'язкові; без GEMINI_API_KEY і без VERTEX_PROJECT маршрут відповідає 503 {"brain":false}.
# VERTEX_PROJECT з GOOGLE_SA_JSON (вміст JSON сервісного акаунта; лише через `flyctl secrets set`,
# не в .env) чи GOOGLE_APPLICATION_CREDENTIALS (шлях до нього) веде запити у Vertex AI.
# VERTEX_LOCATION типово global.

GEMINI_API_KEY=
BRAIN_DAILY_PER_DEVICE=
BRAIN_PER_IP_MINUTE=
BRAIN_PER_IP_DAY=
BRAIN_DAILY_GLOBAL=
BRAIN_DAY_KEY_ONLY=
BRAIN_DAY_FREE=
BRAIN_DAY_PERSONAL=
BRAIN_DAY_CREW=
BRAIN_DAY_LEGACY_TOTAL=
BRAIN_ATTEST_PER_IP_DAY=
BRAIN_KEY_ONLY_IP_FACTOR=
PLAY_INTEGRITY_DECRYPTION_KEY=
PLAY_INTEGRITY_VERIFICATION_KEY=
VERTEX_PROJECT=
VERTEX_LOCATION=
GOOGLE_SA_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
